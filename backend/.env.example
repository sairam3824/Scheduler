# ---------------------------------------------------------------- application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview_scheduler
# SQLite (zero-setup local development):
DATABASE_URL=sqlite:///./academisync.db
SQL_ECHO=false

# ------------------------------------------------------------------- security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# bootstrap administrator created on first start
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_NAME=System Administrator

# --------------------------------------------------------------------- upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ----------------------------------------------------------------- scheduling
DEFAULT_INTERVIEW_DURATION_MIN=30
DEFAULT_BREAK_DURATION_MIN=10
DEFAULT_DAY_START=09:00
DEFAULT_DAY_END=17:00
DEFAULT_SLOT_GRANULARITY_MIN=15
DEFAULT_MIN_PANEL_SIZE=2
DEFAULT_MAX_PANEL_SIZE=4
DEFAULT_MAX_INTERVIEWS_PER_FACULTY_PER_DAY=12
DEFAULT_ALGORITHM=optimized
